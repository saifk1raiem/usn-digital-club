{
  "expo": {
    "name": "USN Digital Club",
    "slug": "usn-digital-club",
    "scheme": "usn",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tn.usn.digitalclub"
    },
    "android": {
      "package": "tn.usn.digitalclub",
      "adaptiveIcon": {
        "backgroundColor": "#081421"
      }
    }
  }
}
